# Environment Variables for Comic-Pro Frontend
# Copy this file to .env.local for local development
# Copy this file to .env.production for production builds

# API Base URL for PDF service
# For local development: http://localhost:3001/api
# For production with droplet: http://YOUR_DROPLET_IP:3001/api
# For production with domain: https://your-domain.com/api
VITE_API_BASE_URL=http://localhost:3001/api

# Environment
NODE_ENV=development 