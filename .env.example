# Environment Configuration Example
# Copy this to .env.local for local development and .env.production for production

# Environment Type
NODE_ENV=development

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
COMIC_CREATOR_URL=http://localhost:5173

# PDF Compression Service (iLovePDF)
# Get these from: https://developer.ilovepdf.com/
ILOVEPDF_PUBLIC_KEY=your_ilovepdf_public_key_here
ILOVEPDF_SECRET_KEY=your_ilovepdf_secret_key_here

# Local Export Directory
EXPORT_OUTPUT_DIR=./comic_exports_output

# Development Settings
VITE_PORT=5173

# ===========================================
# Production Settings (copy to .env.production)
# ===========================================
# NODE_ENV=production
# VITE_API_BASE_URL=https://your-pdf-service.ondigitalocean.app/api
# COMIC_CREATOR_URL=https://your-comic-app.vercel.app
# ILOVEPDF_PUBLIC_KEY=your_production_key_here
# ILOVEPDF_SECRET_KEY=your_production_secret_here
# EXPORT_OUTPUT_DIR=/tmp/exports 